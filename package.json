{
  "name": "trade-order-system",
  "version": "3.166.0",
  "private": true,
  "description": "Local trade order tracking system with a native Mac host, SQLite storage, and logistics API helpers.",
  "scripts": {
    "start": "node mac-app/server.js",
    "check": "node scripts/check-project.js",
    "lint": "node scripts/lint.js",
    "check:release": "node scripts/check-release.js",
    "test": "node scripts/run-tests.js",
    "test:board-layout": "node scripts/test-board-layout.js",
    "test:install-browser": "playwright install chromium",
    "test:webkit": "node scripts/test-webkit-interactions-ui.js && node scripts/test-client-picker-open-profile.js",
    "test:native": "cd mac-app/native && swift run TradeOrderSystemCoreTests",
    "bench": "node scripts/bench-render-save.js",
    "test:api": "node scripts/test-tracking-api.js",
    "test:api:dhl": "node scripts/test-tracking-api.js DHL",
    "test:api:fedex": "node scripts/test-tracking-api.js FedEx"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.12.0",
    "playwright": "1.62.1"
  }
}
