{
  "manifest_version": 3,
  "name": "KME WhatsApp 客户同步",
  "version": "0.2.0",
  "minimum_chrome_version": "111",
  "description": "将已关联客户的 WhatsApp Web 聊天记录同步到本机外贸订单跟进系统。",
  "permissions": ["storage", "nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "打开 KME WhatsApp 客户同步" },
  "content_scripts": [
    { "matches": ["https://web.whatsapp.com/*"], "js": ["vendor/wppconnect-wa.js", "wa-page.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://web.whatsapp.com/*"], "js": ["collector.js", "content.js"], "run_at": "document_idle" }
  ],
  "key": ""
}
